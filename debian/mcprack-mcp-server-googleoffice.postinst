#!/bin/sh
set -e

case "$1" in
  configure)
    if getent passwd mcprack >/dev/null 2>&1 && [ -d /usr/lib/mcprack ]; then
      su -s /bin/sh mcprack -c "cd /usr/lib/mcprack && set -a; . /etc/mcprack/env; set +a; \
        mcprack server create mcp-server-googleoffice \
          --label 'Google Workspace' \
          --transport stdio \
          --command /usr/bin/mcp-server-googleoffice \
          --set-env WORKSPACE_MCP_READ_ONLY=true \
          --set-env MCP_SINGLE_USER_MODE=1 \
          --category debian \
          --enabled" || true
    fi
    ;;
esac

#DEBHELPER#

exit 0
